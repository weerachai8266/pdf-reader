{
  "name": "pdf-reader",
  "productName": "PDF Reader",
  "version": "0.17.0",
  "description": "เนเธเธฃเนเธเธฃเธกเธญเนเธฒเธ PDF เธ—เธตเนเน€เธเธฒ เน€เธฃเนเธง เธฃเธญเธเธฃเธฑเธเธ เธฒเธฉเธฒเนเธ—เธข เนเธฎเนเธฅเธ•เน เธเธญเธกเน€เธกเธเธ•เน เน€เธเนเธ เนเธฅเธฐเธเธฑเธ”เธเธฒเธฃเธซเธเนเธฒเนเธ”เนเธเธฃเธต",
  "author": "PDF Reader",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "test": "electron test/smoke.js",
    "icons": "electron tools/make-icons.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "publish:update": "powershell -ExecutionPolicy Bypass -File tools/publish-update.ps1"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tha": "^1.0.0",
    "electron-updater": "^6.8.11",
    "node-forge": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.62.0"
  },
  "build": {
    "appId": "com.pdfreader.desktop",
    "productName": "PDF Reader",
    "copyright": "PDF Reader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "src/**",
      "config/**",
      "build/icon.ico",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/web/*.*",
      "!node_modules/@napi-rs/**",
      "!node_modules/tesseract.js-core/tesseract-core.*",
      "!node_modules/tesseract.js-core/tesseract-core-simd.*",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.*",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/tesseract.js/src/**"
    ],
    "extraResources": [
      {
        "from": "vendor/libreoffice",
        "to": "libreoffice"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "เน€เธญเธเธชเธฒเธฃ PDF",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://192.168.0.44/pdf-reader/",
        "useMultipleRangeRequest": false
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "PDF-Reader-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Reader",
      "uninstallDisplayName": "PDF Reader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
